# Dr. Flash Environment Configuration
# =====================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real credentials.

# =========================
# Core Settings
# =========================
DRFLASH_ENV=development
DRFLASH_HOST=127.0.0.1
DRFLASH_PORT=8000
DRFLASH_LOG_LEVEL=INFO
DRFLASH_SECRET_KEY=change-me-to-a-random-string

# =========================
# Database
# =========================
DRFLASH_DB_URL=sqlite+aiosqlite:///./data/drflash.db

# =========================
# Model Router
# =========================
OLLAMA_BASE_URL=http://localhost:11434
DRFLASH_DEFAULT_LOCAL_MODEL=qwen2.5:7b-instruct-q4_K_M
DRFLASH_FAST_MODEL=llama3.2:3b
DRFLASH_EMBEDDING_MODEL=nomic-embed-text:latest

# =========================
# AWS / Bedrock (optional)
# =========================
# AWS_PROFILE=drflash-personal
# AWS_REGION=us-east-1
# BEDROCK_ENABLED=false

# =========================
# Sandbox / Workspace
# =========================
DRFLASH_SANDBOX_ROOT=./sandbox
DRFLASH_WORKSPACE_ROOT=./workspace

# =========================
# Budget Limits (USD)
# =========================
DRFLASH_MONTHLY_BUDGET_USD=25.00
DRFLASH_DAILY_BUDGET_USD=3.00
DRFLASH_PER_TASK_BUDGET_USD=0.50

# =========================
# Voice
# =========================
# DRFLASH_WAKE_WORD_ENABLED=true
# DRFLASH_TTS_ENGINE=edge-tts
# DRFLASH_VOICE=en-US-GuyNeural
