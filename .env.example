# JARVIS Environment Configuration
# ==================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real credentials.

# =========================
# Core Settings
# =========================
JARVIS_ENV=development
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=INFO
JARVIS_SECRET_KEY=change-me-to-a-random-string

# =========================
# Database
# =========================
JARVIS_DB_URL=sqlite+aiosqlite:///./data/jarvis.db

# =========================
# Model Router
# =========================
# Local model provider (ollama)
OLLAMA_BASE_URL=http://localhost:11434
JARVIS_DEFAULT_LOCAL_MODEL=qwen2.5:7b-instruct-q4_K_M
JARVIS_FAST_MODEL=llama3.2:3b
JARVIS_EMBEDDING_MODEL=nomic-embed-text:latest

# =========================
# AWS / Bedrock (optional, Phase 2+)
# =========================
# AWS_PROFILE=jarvis-personal
# AWS_REGION=us-east-1
# BEDROCK_ENABLED=false

# =========================
# Sandbox / Workspace
# =========================
JARVIS_SANDBOX_ROOT=./sandbox
JARVIS_WORKSPACE_ROOT=./workspace

# =========================
# Budget Limits (USD)
# =========================
JARVIS_MONTHLY_BUDGET_USD=25.00
JARVIS_DAILY_BUDGET_USD=3.00
JARVIS_PER_TASK_BUDGET_USD=0.50

# =========================
# Voice (Phase 2+)
# =========================
# JARVIS_WAKE_WORD_ENABLED=false
# JARVIS_TTS_ENGINE=local
# JARVIS_ASR_ENGINE=local
